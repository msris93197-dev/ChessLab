# Copy to .env for running the API/worker directly on your machine (outside Docker).
# Never commit .env. Production values live in Render's dashboard.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://chesslab:chesslab@localhost:5433/chesslab
ALLOWED_ORIGINS=http://localhost:5180
SESSION_TTL_DAYS=30
STOCKFISH_PATH=stockfish
ENGINE_THREADS=1
ENGINE_HASH_MB=32
ANALYSIS_DEPTH=14
ANALYSIS_TIME_S=0.5
MAX_IMPORT_GAMES=200
PROVIDER_USER_AGENT=ChessLab portfolio project (contact: you@example.com)
JOB_LEASE_SECONDS=60
LOG_LEVEL=INFO
# Stretch phase S3 only:
LLM_REWORDING_ENABLED=false
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...   (set it in Render's secret settings, never in git)
